# Copy this file to .env.local and fill it in. Restart `npm run dev` afterwards.
#
# Web3Forms access key for the booking form. Get one free at https://web3forms.com
# (enter the email address that should receive booking requests; the key is emailed to you).
# This key is public by design, so it is safe in client code.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
